{
  "name": "devtools-cli",
  "version": "1.0.0",
  "description": "A collection of developer utilities",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "devtools": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "cli",
    "devtools",
    "utilities",
    "developer-tools"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.3",
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "jose": "^6.2.3",
    "js-yaml": "^4.2.0",
    "node-forge": "^1.4.0",
    "ora": "^9.4.0",
    "sharp": "^0.35.1",
    "sql-formatter": "^15.8.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}